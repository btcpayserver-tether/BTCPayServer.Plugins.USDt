@using BTCPayServer
@using BTCPayServer.Abstractions.Contracts
@using BTCPayServer.Data
@using BTCPayServer.Payments
@using BTCPayServer.Plugins.USDt.Configuration
@using BTCPayServer.Plugins.USDt.Controllers
@using BTCPayServer.Plugins.USDt.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@inject SignInManager<ApplicationUser> SignInManager;
@inject USDtPluginConfiguration USDtPluginConfiguration;
@inject IScopeProvider ScopeProvider
@inject UITronUSDtLikeStoreController UITronUSDtLikeStore;
@inject TronUSDtRPCProvider TronUSDtRPCProvider;
@inject UIEVMUSDtLikeStoreController UIEvmUsdTLikeStore;
@inject EVMUSDtRPCProvider EvmUsdTRpcProvider;
@{
    var storeId = ScopeProvider.GetCurrentStoreId();
    var hasTron = USDtPluginConfiguration.TronUSDtLikeConfigurationItems.Any();
    var hasEvm = USDtPluginConfiguration.EVMUSDtLikeConfigurationItems.Any();
}
@if (SignInManager.IsSignedIn(User) && (hasTron || hasEvm))
{
    var store = Context.GetStoreData();
    var networks = new List<(PaymentMethodId PaymentMethodId, bool Enabled, bool Available, string Name, string Controller, string Action)>();
    if (hasTron)
    {
        foreach (var item in UITronUSDtLikeStore.GetVM(store).Items)
        {
            networks.Add((item.PaymentMethodId, item.Enabled, TronUSDtRPCProvider.IsAvailable(item.PaymentMethodId),
                "TRON", "UITronUSDtLikeStore", "GetStoreTronUSDtLikePaymentMethod"));
        }
    }
    if (hasEvm)
    {
        foreach (var item in UIEvmUsdTLikeStore.GetVM(store).Items)
        {
            var chainName = USDtPluginConfiguration.EVMUSDtLikeConfigurationItems.TryGetValue(item.PaymentMethodId, out var config) ? config.Chain : item.DisplayName;
            networks.Add((item.PaymentMethodId, item.Enabled, EvmUsdTRpcProvider.IsAvailable(item.PaymentMethodId),
                chainName, "UIEVMUSDtLikeStore", "GetStoreEVMUSDtLikePaymentMethod"));
        }
    }

    var parentStatus = !networks.Any(network => network.Enabled) ? "pending"
        : networks.Any(network => network.Enabled && !network.Available) ? "disabled" : "enabled";
    var defaultNetwork = networks.FirstOrDefault(network => network.Enabled, networks[0]);
    var activeController = ViewContext.RouteData.Values["controller"]?.ToString();
    var activeMethod = ViewContext.RouteData.Values["paymentMethodId"]?.ToString();
    var active = !string.IsNullOrEmpty(storeId) && networks.Any(network =>
        string.Equals(activeController, network.Controller, StringComparison.OrdinalIgnoreCase) &&
        network.PaymentMethodId.ToString() == activeMethod);

    <li class="nav-item">
        <a id="Nav-USDt" class="nav-link @(active ? "active" : "")"
           asp-controller="@defaultNetwork.Controller" asp-action="@defaultNetwork.Action"
           asp-route-storeId="@storeId" asp-route-paymentMethodId="@defaultNetwork.PaymentMethodId">
            <span class="me-2 btcpay-status btcpay-status--@parentStatus"></span>
            <span>USD₮</span>
        </a>
        @if (active)
        {
            <ul id="Nav-USDt-Networks" class="navbar-nav">
                @foreach (var network in networks)
                {
                    var networkActive = string.Equals(activeController, network.Controller, StringComparison.OrdinalIgnoreCase) &&
                        network.PaymentMethodId.ToString() == activeMethod;
                    var status = !network.Enabled ? "pending" : network.Available ? "enabled" : "disabled";
                    <li class="nav-item nav-item-sub">
                        <a class="nav-link @(networkActive ? "active" : "")"
                           asp-controller="@network.Controller" asp-action="@network.Action"
                           asp-route-storeId="@storeId" asp-route-paymentMethodId="@network.PaymentMethodId">
                            <span class="me-2 btcpay-status btcpay-status--@status"></span>
                            <span>@network.Name</span>
                        </a>
                    </li>
                }
            </ul>
        }
    </li>
}
