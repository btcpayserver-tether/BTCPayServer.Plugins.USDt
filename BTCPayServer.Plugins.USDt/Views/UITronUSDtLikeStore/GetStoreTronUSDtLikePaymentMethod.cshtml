@using BTCPayServer.Abstractions.Extensions
@using BTCPayServer.Abstractions.Models
@using BTCPayServer.Client
@using BTCPayServer.Plugins.USDt
@using BTCPayServer.Plugins.USDt.Services.Payments
@using BTCPayServer.Views.Stores
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Routing
@model BTCPayServer.Plugins.USDt.Controllers.ViewModels.EditTronUSDtPaymentMethodViewModel;

@{
    // ReSharper disable once Razor.LayoutNotResolved
    ViewData.SetActivePage(USDtPlugin.PluginNavKey, typeof(StoreNavPages).ToString(), "USD\u20ae on TRON payment settings", "TronStore");
}
<h3 class="mb-3">USD₮ on TRON payment settings</h3>
<div class="row">
    <div class="col-md-6">
        <div asp-validation-summary="All"></div>
    </div>
</div>
<partial name="_StatusMessage"/>
<svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
    <symbol id="check-circle-fill" fill="currentColor" viewBox="0 0 16 16">
        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
    </symbol>
    <symbol id="info-fill" fill="currentColor" viewBox="0 0 16 16">
        <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
    </symbol>
    <symbol id="exclamation-triangle-fill" fill="currentColor" viewBox="0 0 16 16">
        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
    </symbol>
</svg>
<div class="row">
    <div class="col-md-8">
        <p class="mb-0">
            Configures the addresses used for payments by your customers. Each address is reserved for the time of payment and settlement, so we advise you to set several addresses.
        </p>
        <form method="post"
              asp-route-storeId="@Context.GetRouteValue("storeId")"
              asp-route-paymentMethodId="@Context.GetRouteValue("paymentMethodId")"
              class="mt-4" enctype="multipart/form-data">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <input asp-for="Address" type="text" class="form-control" placeholder="TNPeeaaFB7K9cmo4uQpcU32zGK8G1NYqeL" style="flex: 1 1 14rem">
                <button type="submit" role="button" class="btn btn-primary text-nowrap flex-grow-1 flex-sm-grow-0">Add address(es)</button>
            </div>
            <div class="form-text">
                You can add multiple addresses separated by a comma or a new line.
            </div>
        </form>
        @if (Model.Addresses.Any())
        {
            <table class="table table-hover table-responsive-md">
                <thead>
                <tr>
                    <th>Address</th>
                    <th>Balance</th>
                    <th>
                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="Addresses are attached to pending payments and free after settlement.">Free or used? <vc:icon symbol="info"/></span>
                    </th>
                    <th class="actions-col" permission="@Policies.CanModifyStoreSettings">Actions</th>
                </tr>
                </thead>
                <tbody id="StoreUsersList">

                @foreach (var address in Model.Addresses)
                {
                    <tr>
                        <td>@address.Value</td>
                        <td>@address.Balance</td>
                        <td class="text-center">
                            @if (address.Available)
                            {
                                <span class="me-2 btcpay-status btcpay-status--enabled"></span>
                            }
                            else
                            {
                                <span class="me-2 btcpay-status btcpay-status--disabled"></span>
                            }
                        </td>

                        <td class="actions-col" permission="@Policies.CanModifyStoreSettings">
                            <form method="post" asp-action="DeleteAddress"
                                  asp-route-storeId="@Context.GetRouteValue("storeId")"
                                  asp-route-paymentMethodId="@Context.GetRouteValue("paymentMethodId")"
                                  asp-route-address="@address.Value"
                                  enctype="multipart/form-data">
                                <input class="btn btn-link p-0" type="submit" value="Remove"/>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            if (Model.Addresses.Any(a => a.Balance == "N/A"))
            {
                <div class="alert alert-danger d-flex align-items-center" role="alert">
                    <svg class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Warning:">
                        <use xlink:href="#exclamation-triangle-fill"/>
                    </svg>
                    <div>
                        Unable to retrieve balances for addresses. Please verify your node connection.
                    </div>
                </div>
            }

            <div class="alert alert-warning d-flex align-items-center" role="alert">
                <svg class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Warning:">
                    <use xlink:href="#exclamation-triangle-fill"/>
                </svg>
                <div>
                    Please avoid using these addresses for any transactions outside this store to ensure proper invoice matching.
                </div>
            </div>
        }
        else
        {
            <br/>
            <div class="alert alert-info">
                Please add at least one address before using this payment method.
            </div>
        }
        <partial name="_Confirm" model="@(new ConfirmModel("Remove address", "This action will stop tracking the selected address for this store. Are you sure?", "Delete"))" permission="@Policies.CanModifyStoreSettings"/>
        <form method="post"
              asp-route-storeId="@Context.GetRouteValue("storeId")"
              asp-route-paymentMethodId="@Context.GetRouteValue("paymentMethodId")" class="mt-4" enctype="multipart/form-data">

            <div class="d-flex mb-3">
                <input asp-for="Enabled" type="checkbox" class="btcpay-toggle me-3"/>
                <label asp-for="Enabled" class="form-check-label"></label>
                <span asp-validation-for="Enabled" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="PaymentLinkFormat" class="form-label">Payment link format</label>
                <select asp-for="PaymentLinkFormat" class="form-select">
                    <option value="@((int)USDtPaymentLinkFormat.Standard)">TRON URI with amount (recommended)</option>
                    <option value="@((int)USDtPaymentLinkFormat.StandardWithoutAmount)">TRON URI without amount</option>
                    <option value="@((int)USDtPaymentLinkFormat.AddressOnly)">Address only</option>
                    <option value="@((int)USDtPaymentLinkFormat.Custom)">Custom template</option>
                </select>
                <span asp-validation-for="PaymentLinkFormat" class="text-danger"></span>
            </div>
            <div class="form-text mb-3">
                Address-only links require customers to select TRON and USD₮ and enter the amount manually.
            </div>
            <div id="PaymentLinkTemplateGroup" class="form-group mb-3" hidden
                 data-allowed-placeholders="{to},{amount},{amountUnits},{smartContractAddress}"
                 data-to="@Model.TemplatePreviewDestination"
                 data-amount="@Model.TemplatePreviewAmount"
                 data-amount-units="@Model.TemplatePreviewAmountUnits"
                 data-smart-contract-address="@Model.TemplatePreviewSmartContractAddress">
                <label asp-for="PaymentLinkTemplate" class="form-label">Custom payment link template</label>
                <textarea asp-for="PaymentLinkTemplate" class="form-control" rows="3" maxlength="2048"
                          placeholder="tron:{to}?amount={amount}"></textarea>
                <div class="form-text">
                    Required placeholder: <code>{to}</code>. Available placeholders:
                    <code>{to}</code>, <code>{amount}</code>, <code>{amountUnits}</code>,
                    <code>{smartContractAddress}</code>.
                </div>
                <div id="PaymentLinkTemplateError" class="text-danger mt-2" role="alert"></div>
                <div id="PaymentLinkTemplatePreview" class="mt-2" hidden>
                    <span class="form-label">Preview</span>
                    <code id="PaymentLinkTemplatePreviewValue" class="d-block text-break"></code>
                </div>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary" id="SaveButton">Save</button>
            </div>
        </form>
    </div>
</div>


@* ReSharper disable once Razor.SectionNotResolved *@

@section PageFootContent {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (() => {
            const format = document.getElementById('PaymentLinkFormat');
            const template = document.getElementById('PaymentLinkTemplate');
            const group = document.getElementById('PaymentLinkTemplateGroup');
            const error = document.getElementById('PaymentLinkTemplateError');
            const preview = document.getElementById('PaymentLinkTemplatePreview');
            const previewValue = document.getElementById('PaymentLinkTemplatePreviewValue');
            const allowed = new Set(group.dataset.allowedPlaceholders.split(','));
            const values = {
                '{to}': group.dataset.to,
                '{amount}': group.dataset.amount,
                '{amountUnits}': group.dataset.amountUnits,
                '{smartContractAddress}': group.dataset.smartContractAddress
            };
            const placeholderPattern = /\{[^{}]*\}/g;

            const render = () => {
                const custom = format.value === '@((int)USDtPaymentLinkFormat.Custom)';
                group.hidden = !custom;
                error.textContent = '';
                preview.hidden = true;
                if (!custom) return true;

                const value = template.value;
                let message = '';
                if (!value.trim()) message = 'A payment link template is required.';
                else if (value.length > 2048) message = 'The payment link template cannot exceed 2048 characters.';
                else if (/[\u0000-\u001F\u007F]/.test(value)) message = 'Control characters are not allowed.';

                const placeholders = value.match(placeholderPattern) || [];
                if (!message) {
                    const unsupported = placeholders.find(item => !allowed.has(item));
                    if (unsupported) message = `Unknown or unsupported placeholder: ${unsupported}.`;
                }
                if (!message && value.replace(placeholderPattern, '').match(/[{}]/))
                    message = 'The template contains an invalid placeholder expression.';
                if (!message && !value.includes('{to}'))
                    message = 'The template must contain the {to} placeholder.';

                if (message) {
                    error.textContent = message;
                    return false;
                }

                const rendered = value.replace(placeholderPattern, item => values[item]);
                if (!rendered.trim() || rendered.length > 4096) {
                    error.textContent = 'The rendered payment link is empty or too long.';
                    return false;
                }

                previewValue.textContent = rendered;
                preview.hidden = false;
                return true;
            };

            format.addEventListener('change', render);
            template.addEventListener('input', render);
            format.closest('form').addEventListener('submit', event => {
                if (!render()) event.preventDefault();
            });
            render();
        })();
    </script>
}
